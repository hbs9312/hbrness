{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "timeout": 10,
          "command": "python3 \"{HBRNESS_PLUGIN_PATH}/scripts/sfhook.py\" stop --tool devin"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "timeout": 10,
          "command": "python3 \"{HBRNESS_PLUGIN_PATH}/scripts/sfhook.py\" session-end --tool devin"
        }
      ]
    }
  ]
}
