{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planflow plan.json schema",
  "type": "object",
  "required": ["title", "questions"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "lang": { "enum": ["ko", "en"], "default": "ko" },
    "status": { "enum": ["draft", "review", "approved"], "default": "draft" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },

    "overview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "$ref": "#/$defs/i18nString" },
        "current_state": { "$ref": "#/$defs/i18nString" },
        "proposed_approach": { "$ref": "#/$defs/i18nString" },
        "goal": { "$ref": "#/$defs/i18nString" },
        "review_focus": { "type": "array", "items": { "$ref": "#/$defs/i18nString" } },
        "scope_in": { "type": "array", "items": { "$ref": "#/$defs/i18nString" } },
        "scope_out": { "type": "array", "items": { "$ref": "#/$defs/i18nString" } },
        "success_criteria": { "type": "array", "items": { "$ref": "#/$defs/i18nString" } },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/i18nString" } }
      }
    },

    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "$ref": "#/$defs/i18nString" },
          "duration": { "type": "string" },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "tasks": { "type": "array", "items": { "$ref": "#/$defs/i18nString" } },
          "files": {
            "description": "이 phase 가 만지는 파일들. 추상적 의도(tasks)와 구분되는 구체 임팩트.",
            "type": "array",
            "items": { "$ref": "#/$defs/fileChange" }
          }
        }
      }
    },

    "files_touched": {
      "description": "(optional) phase 분류가 어색할 때 사용하는 top-level 변경 파일 목록. phases[].files 가 우선.",
      "type": "array",
      "items": { "$ref": "#/$defs/fileChange" }
    },

    "comments": {
      "description": "사용자가 계획 내용 일부에 남긴 리뷰. 텍스트 선택 후 인라인 코멘트로 추가됨. Claude 는 각 comment 의 replies[] 에 답글을 append.",
      "type": "array",
      "items": { "$ref": "#/$defs/comment" }
    },

    "asks": {
      "description": "사용자가 UI 의 /ask 입력으로 보낸 자유 질문. helper-server 가 append 하고, Claude 가 answer/answered_at/answered_by 를 채운다. 채팅에는 본문 대신 카운트만 알림으로 가서 컨텍스트가 비대해지지 않게 한다.",
      "type": "array",
      "items": { "$ref": "#/$defs/ask" }
    },

    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["mermaid", "image"] },
          "title": { "$ref": "#/$defs/i18nString" },
          "code": { "type": "string" },
          "src": { "type": "string" },
          "alt": { "$ref": "#/$defs/i18nString" }
        }
      }
    },

    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "round": { "type": "integer", "minimum": 1, "default": 1 },
          "group": { "$ref": "#/$defs/i18nString" },
          "type": {
            "enum": ["text", "textarea", "number", "slider", "radio", "checkbox", "select", "toggle", "date", "tag-input"]
          },
          "label": { "$ref": "#/$defs/i18nString" },
          "context": { "$ref": "#/$defs/i18nString" },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
          "recommendation": { "$ref": "#/$defs/i18nString" },
          "tradeoffs": { "type": "array", "items": { "$ref": "#/$defs/tradeoff" } },
          "required": { "type": "boolean", "default": false },
          "default": {},
          "placeholder": { "$ref": "#/$defs/i18nString" },
          "allow_other": { "type": "boolean", "default": false },
          "other_label": { "$ref": "#/$defs/i18nString" },
          "other_placeholder": { "$ref": "#/$defs/i18nString" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "unit": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value"],
              "additionalProperties": false,
              "properties": {
                "value": { "type": ["string", "number", "boolean"] },
                "label": { "$ref": "#/$defs/i18nString" }
              }
            }
          },
          "answer": {},
          "answered_at": { "type": "string" }
        }
      }
    }
  },

  "$defs": {
    "i18nString": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ko": { "type": "string" },
            "en": { "type": "string" }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "summary": { "$ref": "#/$defs/i18nString" }
      }
    },
    "tradeoff": {
      "type": "object",
      "required": ["impact"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "impact": { "$ref": "#/$defs/i18nString" }
      }
    },
    "fileChange": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "change_type": { "enum": ["add", "modify", "delete", "rename"], "default": "modify" },
        "summary": { "$ref": "#/$defs/i18nString" }
      }
    },
    "comment": {
      "type": "object",
      "required": ["id", "anchor_id", "anchor_text", "comment"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "anchor_id": { "type": "string", "description": "render.mjs 가 부여하는 stable unit id (예: phase.P1.task.0)" },
        "anchor_text": { "type": "string", "description": "선택했을 당시의 텍스트 (orphan 추적/표시용)" },
        "comment": { "type": "string" },
        "by": { "enum": ["user", "claude"], "default": "user" },
        "submitted_at": { "type": "string" },
        "replies": { "type": "array", "items": { "$ref": "#/$defs/commentReply" } },
        "resolved": { "type": "boolean", "default": false }
      }
    },
    "commentReply": {
      "type": "object",
      "required": ["by", "text"],
      "additionalProperties": false,
      "properties": {
        "by": { "enum": ["user", "claude"] },
        "text": { "type": "string" },
        "at": { "type": "string" }
      }
    },
    "ask": {
      "type": "object",
      "required": ["id", "ts", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ask-[0-9]{3,}$", "description": "ask-001, ask-002, ... — helper-server 가 단조 증가로 부여" },
        "ts": { "type": "string", "description": "ISO 8601 of when the user submitted" },
        "text": { "type": "string", "minLength": 1 },
        "answer": { "type": ["string", "null"], "default": null, "description": "Claude 가 채움. null 이면 '답변 대기'." },
        "answered_at": { "type": ["string", "null"], "default": null },
        "answered_by": { "anyOf": [{ "enum": ["claude"] }, { "type": "null" }], "default": null }
      }
    }
  }
}
